---
export async function getStaticPaths() {
  const posts = Object.values(import.meta.glob('../../content/noticias/*.md', { eager: true }));
  return posts.map((p) => {
    const slug = p.file.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { nota: p }
    };
  });
}

const { nota } = Astro.props;
const { Content } = nota;

// Formateo de fecha
const fecha = new Date(nota.frontmatter.date);
const formattedDate = `${fecha.getDate()} ${fecha.toLocaleString('es-AR', { month: 'long' })}, ${fecha.getFullYear()}`;

const rawTitle = nota.frontmatter.title || '';

// Función para parsear títulos: Línea 1 = Título (Poppins Bold), Líneas siguientes = Subtítulo (Poppins Light)
function formatTitle(raw) {
  if (!raw) return '';
  const lines = raw
    .replace(/(\*\*|\*|_|`)/g, '')
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  if (lines.length === 0) return '';
  const title = lines[0];
  const subtitle = lines.slice(1).join('<br/>');

  if (!subtitle) {
    return `<span class="titulo-principal">${title}</span>`;
  }
  return `<span class="titulo-principal">${title}</span><span class="subtitulo-nota">${subtitle}</span>`;
}

const titleHtml = formatTitle(rawTitle);

// Limpieza para la pestaña del navegador: solo el primer renglón y sin Markdown
const firstLine = rawTitle.split(/\r?\n/)[0] || '';
const tabTitle = firstLine
  .replace(/(\*\*|\*|_|`)/g, '')
  .trim();

const CATEGORIAS: Record<string, string> = {
  'actualidad-local': 'Actualidad Local',
  'actualidad-provincial': 'Actualidad Provincial',
  'actualidad-nacional': 'Actualidad Nacional',
  'deportes': 'Deportes',
  'cronicas': 'Crónicas & Particularidades',
  'entrevistas': 'Mano a Mano',
  'opinion': 'Opinión & Ensayos'
};

const categoriaKey = nota.frontmatter.categoria || 'actualidad-local';
const categoriaLabel = CATEGORIAS[categoriaKey] || 'Actualidad';
const currentYear = new Date().getFullYear();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tabTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@1,125,900&family=Montserrat:ital,wght@0,300;0,700;0,900;1,300;1,900&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:ital,wght@0,100;0,200;0,300;0,700;1,100;1,200;1,300;1,700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="background-patron"></div>
    
    <article class="nota-container">
      
      <!-- Cabecera institucional con enlace a la portada -->
      <header class="nota-header">
        <div class="masthead">
          <a href="/" class="masthead-link" title="Volver a la portada de Mercedes News">
            <h1 class="diario-title">MERCEDES NEWS</h1>
          </a>
          <p class="diario-lema">«El portal de noticias hecho para vos»</p>
        </div>
        <div class="header-divider"></div>
      </header>

      <!-- Foto de portada con mismos márgenes del contenedor -->
      {nota.frontmatter.thumbnail && (
        <div class="header-section">
          <img src={nota.frontmatter.thumbnail} alt={tabTitle} class="imagen-portada" />
        </div>
      )}

      <!-- Contenido del artículo -->
      <div class="content-section">
        <h1 class="titulo" set:html={titleHtml}></h1>

        <div class="cuerpo-texto">
          <p class="fecha-categoria-row">
            <span class="fecha">{formattedDate}</span>
            <span class="meta-dot">•</span>
            <a href={`/?cat=${categoriaKey}`} class="categoria-link" title={`Ver publicaciones en ${categoriaLabel}`}>
              {categoriaLabel}
            </a>
          </p>
          <Content />
        </div>
      </div>

      <!-- Pie de página editorial simétrico con la portada -->
      <footer class="periodico-footer">
        <div class="footer-divider"></div>
        <div class="footer-content">
          <div class="footer-brand-side">
            <p class="footer-creditos">
              © {currentYear} <strong>Mercedes News</strong> — Todos los derechos reservados.
            </p>
            <div class="footer-social">
              <span class="footer-social-label">Seguinos en</span>
              <a href="https://www.facebook.com/profile.php?id=61594040760082" target="_blank" rel="noopener noreferrer" class="social-btn facebook" title="Seguinos en Facebook" aria-label="Facebook de Mercedes News">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://www.instagram.com/mercedesnews2026/" target="_blank" rel="noopener noreferrer" class="social-btn instagram" title="Seguinos en Instagram" aria-label="Instagram de Mercedes News">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
            </div>
          </div>
          <a href="/admin/" class="footer-admin-link">
            ⚙️ Redacción / CMS
          </a>
        </div>
      </footer>
      
    </article>

    <!-- Script automático para transformar enlaces de YouTube y archivos de video en reproductores -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const cuerpo = document.querySelector('.cuerpo-texto');
        if (!cuerpo) return;

        const isVideo = (url) => /\.(mp4|webm|mov|ogg)(\?.*)?$/i.test(url || '');

        // 1. Imágenes insertadas por el editor que en realidad son videos (.mp4, .webm, .mov)
        cuerpo.querySelectorAll('img').forEach((img) => {
          const src = img.getAttribute('src') || img.src || '';
          if (isVideo(src)) {
            const video = document.createElement('video');
            video.src = img.src || src;
            video.controls = true;
            video.playsInline = true;
            video.className = 'video-reproductor';
            img.parentNode.replaceChild(video, img);
          }
        });

        // 2. Enlaces que apuntan a archivos de video (.mp4, .webm, .mov)
        cuerpo.querySelectorAll('a').forEach((link) => {
          const href = link.getAttribute('href') || '';
          if (isVideo(href)) {
            const video = document.createElement('video');
            video.src = href;
            video.controls = true;
            video.playsInline = true;
            video.className = 'video-reproductor';
            
            const parentP = link.closest('p');
            if (parentP && parentP.textContent.trim() === link.textContent.trim()) {
              parentP.parentNode.replaceChild(video, parentP);
            } else {
              link.parentNode.replaceChild(video, link);
            }
          }
        });

        // 3. Enlaces a videos de YouTube (convierte URLs sueltas en reproductores integrados)
        const allLinks = cuerpo.querySelectorAll('a');
        allLinks.forEach((link) => {
          const href = link.getAttribute('href') || '';
          const ytMatch = href.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i);
          
          if (ytMatch && ytMatch[1]) {
            const videoId = ytMatch[1];
            const parentP = link.closest('p');
            if (parentP && (parentP.textContent.trim() === link.textContent.trim() || parentP.textContent.trim().startsWith('http'))) {
              const wrapper = document.createElement('div');
              wrapper.className = 'video-embed-wrapper';
              wrapper.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${videoId}" title="Reproductor de Video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>`;
              parentP.parentNode.replaceChild(wrapper, parentP);
            }
          }
        });
      });
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  body {
    font-family: 'Open Sans', sans-serif;
    margin: 0;
    padding: 0;
    background-color: #ffffff;
    color: #1e2126;
    -webkit-font-smoothing: antialiased;
  }

  .background-patron {
    display: none;
  }

  .nota-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    background: #ffffff;
    box-shadow: none;
    padding: 15px 20px 60px 20px;
  }

  /* ========================================================
     CABECERA INSTITUCIONAL EN LA NOTA
     ======================================================== */
  .nota-header {
    width: 100%;
    margin-bottom: 25px;
  }

  .masthead {
    text-align: center;
    padding: 15px 0 5px 0;
  }

  .masthead-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
  }

  /* Logotipo Oficial en Archivo Expanded Black Italic */
  .diario-title {
    font-family: 'Archivo', sans-serif;
    font-style: italic;
    font-weight: 900;
    font-stretch: expanded;
    font-size: clamp(2.8rem, 8vw, 6.2rem);
    letter-spacing: -2px;
    color: #0252c5;
    margin: 0;
    line-height: 0.95;
    text-transform: uppercase;
    text-align: center;
    width: 100%;
    display: block;
    transition: color 0.2s ease;
  }

  .masthead-link:hover .diario-title {
    color: #013788;
  }

  .diario-lema {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.88rem;
    font-style: italic;
    color: #666;
    margin: 10px 0 0 0;
    text-align: center;
  }

  /* Doble Pleca Azul Auténtica (Línea gruesa 4px + espacio 7px + línea fina 1.5px) */
  .header-divider {
    border-top: 4px solid #0252c5;
    border-bottom: 1.5px solid rgba(2, 82, 197, 0.45);
    height: 7px;
    margin-top: 20px;
    margin-bottom: 30px;
  }

  /* ========================================================
     FOTO DE PORTADA CON MÁRGENES HOMOGÉNEOS
     ======================================================== */
  .header-section {
    margin-bottom: 30px;
    overflow: hidden;
    background: #000000;
  }

  .imagen-portada {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    display: block;
  }

  .content-section {
    padding: 0;
    margin-bottom: 40px;
  }

  /* Título y Subtítulo con Poppins */
  .titulo {
    margin: 10px 0 30px 0;
  }

  .titulo .titulo-principal {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-weight: 700; /* Poppins Bold */
    font-size: 2.4rem;
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: #1e2126;
  }

  .titulo .subtitulo-nota {
    display: block;
    font-family: 'Poppins', sans-serif;
    font-weight: 300; /* Poppins Light (peso legible) */
    font-size: 1.35rem;
    line-height: 1.25;
    color: #1e2126;
    margin-top: 12px;
  }

  /* Fila de Metadatos (Fecha y Categoría) */
  .fecha-categoria-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 25px;
    font-family: 'Montserrat', sans-serif;
  }

  .fecha-categoria-row .fecha {
    font-family: 'Montserrat', sans-serif;
    color: #888;
    font-size: 0.88rem;
    margin-bottom: 0;
  }

  .fecha-categoria-row .meta-dot {
    color: #bbb;
    font-size: 0.85rem;
  }

  .fecha-categoria-row .categoria-link {
    font-family: 'Montserrat', sans-serif;
    color: #0252c5;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: color 0.15s ease, text-decoration 0.15s ease;
  }

  .fecha-categoria-row .categoria-link:hover {
    color: #013788;
    text-decoration: underline;
  }

  /* Cuerpo del Texto y Justificación */
  .cuerpo-texto {
    line-height: 1.6;
    font-size: 1.05rem;
    color: #222;
    column-count: 1;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .cuerpo-texto p {
    text-align: justify;
    text-align-last: left;
    text-justify: inter-word;
    text-wrap: pretty;
    margin-bottom: 1.2em;
    margin-top: 0;
  }

  .cuerpo-texto img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 20px auto;
    border-radius: 0;
    break-inside: avoid;
  }

  .cuerpo-texto .video-reproductor {
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 480px;
    display: block;
    margin: 25px auto;
    border-radius: 8px;
    background-color: #000;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    break-inside: avoid;
  }

  .cuerpo-texto .video-embed-wrapper {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%; /* Relación de aspecto 16:9 */
    height: 0;
    margin: 25px 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: #000;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    break-inside: avoid;
  }

  .cuerpo-texto .video-embed-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .cuerpo-texto h2, 
  .cuerpo-texto h3, 
  .cuerpo-texto h4 {
    break-after: avoid;
    break-inside: avoid;
    margin: 0;
  }

  .cuerpo-texto a {
    overflow-wrap: anywhere;
    word-break: break-all;
    color: #0252c5;
  }

  .cuerpo-texto blockquote {
    margin: 25px 0;
    padding: 0;
    border: none;
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 1.65rem;
    font-style: italic;
    color: #333;
    break-inside: avoid;
    line-height: 1.3;
  }

  .cuerpo-texto blockquote::before {
    content: '“';
    display: block;
    font-size: 3.2rem;
    color: #888;
    line-height: 0.6;
    margin-bottom: 2px;
  }

  .cuerpo-texto blockquote::after {
    content: '”';
    display: block;
    font-size: 3.2rem;
    color: #888;
    line-height: 0.6;
    text-align: right;
    margin-top: 6px;
  }

  .cuerpo-texto mark {
    background-color: rgba(2, 82, 197, 0.12);
    color: inherit;
    padding: 0 4px;
  }

  /* ========================================================
     PIE DE PÁGINA (Footer)
     ======================================================== */
  .periodico-footer {
    margin-top: 60px;
    padding-top: 15px;
  }

  .footer-divider {
    border-top: 1px solid rgba(2, 82, 197, 0.4);
    border-bottom: 3px solid #0252c5;
    height: 3px;
    margin-bottom: 15px;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    font-size: 0.8rem;
    color: #666;
  }

  .footer-brand-side {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-creditos {
    margin: 0;
  }

  .footer-social {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .footer-social-label {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: #777777;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Botones de Redes Sociales */
  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #555555;
    background: transparent;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .social-btn:hover {
    transform: translateY(-1px) scale(1.1);
  }

  .social-btn.facebook:hover {
    color: #1877F2;
    background: rgba(24, 119, 242, 0.1);
  }

  .social-btn.instagram:hover {
    color: #E4405F;
    background: rgba(228, 64, 95, 0.1);
  }

  .footer-admin-link {
    text-decoration: none;
    color: #666;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 8px;
    border: 1px solid #d5d9da;
    border-radius: 4px;
    transition: all 0.2s ease;
  }

  .footer-admin-link:hover {
    color: #1e2126;
    border-color: #0252c5;
    background: #f9f9f9;
  }

  /* ========================================================
     RESPONSIVE DESKTOP (A partir de 768px)
     ======================================================== */
  @media (min-width: 768px) {
    .nota-container {
      padding: 15px 60px 80px 60px;
    }

    .diario-title {
      font-size: clamp(3.4rem, 8vw, 6.2rem);
      letter-spacing: -2px;
    }

    .titulo .titulo-principal {
      font-size: 4.5rem;
      line-height: 0.98;
      letter-spacing: -2px;
    }

    .titulo .subtitulo-nota {
      font-size: 2.2rem;
      line-height: 1.15;
      margin-top: 15px;
    }

    .cuerpo-texto {
      column-count: 2;
      column-gap: 50px;
      column-rule: 1px solid rgba(2, 82, 197, 0.15);
    }
  }
</style>
