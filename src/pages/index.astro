---
// Cargamos todas las noticias de la carpeta content/noticias
const rawNotas = Object.values(import.meta.glob('../content/noticias/*.md', { eager: true }));

// Mapa de categorías oficiales
const CATEGORIAS: Record<string, string> = {
  'actualidad-local': 'Actualidad Local',
  'actualidad-provincial': 'Actualidad Provincial',
  'actualidad-nacional': 'Actualidad Nacional',
  'deportes': 'Deportes',
  'cronicas': 'Crónicas & Particularidades',
  'entrevistas': 'Mano a Mano',
  'opinion': 'Opinión & Ensayos'
};

// Función para calcular diferencia en días calendario
function getCalendarDaysDiff(dateString) {
  if (!dateString) return 0;
  const now = new Date();
  const target = new Date(dateString);
  const d1 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const d2 = new Date(target.getFullYear(), target.getMonth(), target.getDate());
  const diffTime = d1.getTime() - d2.getTime();
  return Math.max(0, Math.floor(diffTime / (1000 * 60 * 60 * 24)));
}

// Ordenamos las notas por fecha de forma descendente (la más reciente primero)
const notas = rawNotas
  .map((nota) => {
    const slug = nota.file.split('/').pop().replace('.md', '');
    const cat = nota.frontmatter.categoria || 'actualidad-local';
    const daysAgo = getCalendarDaysDiff(nota.frontmatter.date);
    const isOld = daysAgo > 3;
    const timestamp = new Date(nota.frontmatter.date).getTime();
    return { ...nota, slug, cat, daysAgo, isOld, timestamp };
  })
  .sort((a, b) => b.timestamp - a.timestamp);

// Partición de notas:
// - La nota más reciente (notas[0]) siempre lidera la Tapa destacada
// - Las demás se dividen en secundarias recientes (<= 3 días) y archivo (> 3 días)
const leadNota = notas[0];
const restNotas = notas.slice(1);
const secundariasRecientes = restNotas.filter((n) => !n.isOld);
const notasLoQueTenesQueSaber = restNotas.filter((n) => n.isOld);

// Función para formatear fechas al estilo editorial
function formatDate(dateString) {
  if (!dateString) return '';
  const d = new Date(dateString);
  return `${d.getDate()} ${d.toLocaleString('es-AR', { month: 'long' })}, ${d.getFullYear()}`;
}

// Función para parsear títulos: Línea 1 = Título (Poppins Bold), Líneas siguientes = Subtítulo (Poppins Light)
function formatTitle(rawTitle) {
  if (!rawTitle) return '';
  const lines = rawTitle
    .replace(/(\*\*|\*|_|`)/g, '')
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  if (lines.length === 0) return '';
  const title = lines[0];
  const subtitle = lines.slice(1).join('<br/>');

  if (!subtitle) {
    return `<span class="titulo-principal">${title}</span>`;
  }
  return `<span class="titulo-principal">${title}</span><span class="subtitulo-nota">${subtitle}</span>`;
}

// Función para obtener sólo el primer renglón limpio sin formato para alt y meta
function cleanTitle(rawTitle) {
  if (!rawTitle) return '';
  const firstLine = rawTitle.split(/\r?\n/)[0] || '';
  return firstLine.replace(/(\*\*|\*|_|`)/g, '').trim();
}

// Función para extraer un extracto limpio de texto para la bajada
function getExcerpt(nota, maxLength = 160) {
  const raw = typeof nota.rawContent === 'function' ? nota.rawContent() : '';
  const clean = raw
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/#{1,6}\s+/g, '')
    .replace(/(\*\*|\*|_|`)/g, '')
    .replace(/\n+/g, ' ')
    .trim();
  
  if (clean.length <= maxLength) return clean;
  return clean.slice(0, maxLength).trim() + '…';
}

const today = new Date();
const fechaHoy = today.toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mercedes News — Diario Digital</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@1,125,900&family=Montserrat:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:ital,wght@0,100;0,200;0,300;0,700;1,100;1,200;1,300;1,700&display=swap" rel="stylesheet">
  </head>
  <body>

    <!-- Contenedor exterior del header para evitar saltos o rebotes de layout en scroll -->
    <div class="header-outer" id="header-outer">
      <header class="periodico-header" id="main-header">
        <div class="header-container">
          
          <!-- Barra superior: fecha y localidad (se oculta al scrollear) -->
          <div class="top-bar">
            <span class="top-date">{fechaHoy}</span>
            <span class="top-edition">Edición Digital</span>
            <span class="top-location">Mercedes, Buenos Aires</span>
          </div>

          <!-- Área principal de Cabecera -->
          <div class="masthead-area">
            <div class="brand-box">
              <a href="/" class="brand-link">
                <h1 class="diario-title">MERCEDES NEWS</h1>
              </a>
              <p class="diario-lema">«El portal de noticias hecho para vos»</p>
            </div>

            <!-- Selector desplegable de Categorías -->
            <div class="category-filter-box">
              <div class="dropdown-wrapper" id="cat-dropdown-wrapper">
                <button 
                  type="button" 
                  class="dropdown-trigger-btn" 
                  id="cat-dropdown-btn" 
                  aria-expanded="false"
                >
                  <span class="trigger-label">SECCIÓN:</span>
                  <span class="trigger-value" id="current-cat-name">Todas</span>
                  <span class="trigger-arrow">▾</span>
                </button>
                
                <ul class="dropdown-list" id="cat-dropdown-list">
                  <li data-cat="todas" class="dropdown-item is-selected">Todas las secciones</li>
                  <li data-cat="actualidad-local" class="dropdown-item">Actualidad Local</li>
                  <li data-cat="actualidad-provincial" class="dropdown-item">Actualidad Provincial</li>
                  <li data-cat="actualidad-nacional" class="dropdown-item">Actualidad Nacional</li>
                  <li data-cat="deportes" class="dropdown-item">Deportes</li>
                  <li data-cat="cronicas" class="dropdown-item">Crónicas &amp; Particularidades</li>
                  <li data-cat="entrevistas" class="dropdown-item">Mano a Mano</li>
                  <li data-cat="opinion" class="dropdown-item">Opinión &amp; Ensayos</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Doble pleca azul divisoria -->
          <div class="header-divider"></div>
        </div>
      </header>
    </div>

    <main class="index-container">

      {notas.length === 0 ? (
        <div class="sin-noticias">
          <p>No hay noticias publicadas en este momento.</p>
        </div>
      ) : (
        <section class="noticias-section" id="noticias-section">

          <!-- Contenedor único de noticias -->
          <div class="articulos-wrapper" id="articulos-wrapper">
            
            {/* 1. NOTA DE TAPA (Siempre la más reciente) */}
            {leadNota && (
              <article 
                class="noticia-card is-lead" 
                id={`card-${leadNota.slug}`}
                data-cat={leadNota.cat}
                data-is-old={leadNota.isOld ? 'true' : 'false'}
                data-timestamp={leadNota.timestamp}
              >
                {leadNota.frontmatter.thumbnail && (
                  <div class="card-media">
                    <a href={`/noticias/${leadNota.slug}`} class="media-link">
                      <img 
                        src={leadNota.frontmatter.thumbnail} 
                        alt={cleanTitle(leadNota.frontmatter.title)} 
                        class="card-img" 
                      />
                      <span class="badge-tapa">Tapa</span>
                    </a>
                  </div>
                )}

                <div class="card-content">
                  <div class="meta-row">
                    <span class="fecha">{formatDate(leadNota.frontmatter.date)}</span>
                    <span class="meta-dot">•</span>
                    <button 
                      type="button" 
                      class="cat-pill-btn" 
                      data-filter-cat={leadNota.cat}
                      title={`Filtrar por ${CATEGORIAS[leadNota.cat]}`}
                    >
                      {CATEGORIAS[leadNota.cat] || 'Actualidad'}
                    </button>
                  </div>

                  <h2 class="card-title">
                    <a href={`/noticias/${leadNota.slug}`} class="title-link" set:html={formatTitle(leadNota.frontmatter.title)}></a>
                  </h2>

                  {getExcerpt(leadNota) && (
                    <p class="card-bajada">
                      {getExcerpt(leadNota, 220)}
                    </p>
                  )}

                  <a href={`/noticias/${leadNota.slug}`} class="read-more-link">
                    Leer nota completa <span class="arrow">→</span>
                  </a>
                </div>
              </article>
            )}

            {/* 2. SECCIÓN: OTRAS PUBLICACIONES (Notas de hasta 3 días) */}
            <div 
              class="section-divider-bar" 
              id="section-recientes-bar" 
              style={secundariasRecientes.length === 0 ? "display: none;" : ""}
            >
              <h3 class="section-heading" id="section-recientes-heading">Otras Publicaciones</h3>
              <div class="section-heading-line"></div>
            </div>

            <div 
              class="grilla-secundarias" 
              id="grilla-secundarias" 
              style={secundariasRecientes.length === 0 ? "display: none;" : ""}
            >
              {secundariasRecientes.map((nota) => (
                <article 
                  class="noticia-card is-secondary" 
                  id={`card-${nota.slug}`}
                  data-cat={nota.cat}
                  data-is-old="false"
                  data-timestamp={nota.timestamp}
                >
                  {nota.frontmatter.thumbnail && (
                    <div class="card-media">
                      <a href={`/noticias/${nota.slug}`} class="media-link">
                        <img 
                          src={nota.frontmatter.thumbnail} 
                          alt={cleanTitle(nota.frontmatter.title)} 
                          class="card-img" 
                        />
                      </a>
                    </div>
                  )}

                  <div class="card-content">
                    <div class="meta-row">
                      <span class="fecha">{formatDate(nota.frontmatter.date)}</span>
                      <span class="meta-dot">•</span>
                      <button 
                        type="button" 
                        class="cat-pill-btn" 
                        data-filter-cat={nota.cat}
                        title={`Filtrar por ${CATEGORIAS[nota.cat]}`}
                      >
                        {CATEGORIAS[nota.cat] || 'Actualidad'}
                      </button>
                    </div>

                    <h4 class="card-title">
                      <a href={`/noticias/${nota.slug}`} class="title-link" set:html={formatTitle(nota.frontmatter.title)}></a>
                    </h4>

                    {getExcerpt(nota) && (
                      <p class="card-bajada">
                        {getExcerpt(nota, 130)}
                      </p>
                    )}

                    <a href={`/noticias/${nota.slug}`} class="read-more-link">
                      Leer artículo <span class="arrow">→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>

            {/* SECCIÓN PUBLICITARIA / AUSPICIANTES (Opción B: Franja Intermedia) */}
            <aside class="seccion-publicidades" id="seccion-publicidades" aria-label="Espacio publicitario">
              <div class="publicidad-divider-bar">
                <span class="publicidad-badge">Espacio Publicitario</span>
                <div class="publicidad-divider-line"></div>
              </div>

              <div class="publicidades-grid">
                <!-- Publicidad 1: Gastronomía & Tradición local -->
                <div class="ad-card">
                  <a href="#" class="ad-link" onclick="return false;" title="Auspiciante: Sabores de Mercedes">
                    <div class="ad-inner ad-theme-gastronomia">
                      <span class="ad-micro-label">Auspiciante Oficial</span>
                      <div class="ad-content-box">
                        <span class="ad-icon">🥖</span>
                        <h4 class="ad-brand-name">Sabores de Mercedes</h4>
                        <p class="ad-brand-tagline">Salame Quintero &amp; Quesos de Campo de elaboración artesanal</p>
                      </div>
                      <span class="ad-cta-btn">Conocé Más</span>
                    </div>
                  </a>
                </div>

                <!-- Publicidad 2: Café & Punto de Encuentro local -->
                <div class="ad-card">
                  <a href="#" class="ad-link" onclick="return false;" title="Auspiciante: Café de la Plaza">
                    <div class="ad-inner ad-theme-servicios">
                      <span class="ad-micro-label">Auspiciante Oficial</span>
                      <div class="ad-content-box">
                        <span class="ad-icon">☕</span>
                        <h4 class="ad-brand-name">Café de la Plaza</h4>
                        <p class="ad-brand-tagline">El tradicional punto de encuentro en el centro de nuestra ciudad</p>
                      </div>
                      <span class="ad-cta-btn">Visitanos</span>
                    </div>
                  </a>
                </div>

                <!-- Publicidad 3: Llamado Comercial para Anunciar en Mercedes News -->
                <div class="ad-card ad-card-promo">
                  <a href="mailto:mercedesnews2026@gmail.com" class="ad-link" title="Anunciá en Mercedes News">
                    <div class="ad-inner ad-theme-promo">
                      <span class="ad-micro-label">Mercedes News Comercial</span>
                      <div class="ad-content-box">
                        <span class="ad-icon">📢</span>
                        <h4 class="ad-brand-name">Tu Marca Acá</h4>
                        <p class="ad-brand-tagline">Llegá a toda la comunidad mercedina con presencia destacada</p>
                      </div>
                      <span class="ad-cta-btn ad-cta-highlight">Anunciá con nosotros</span>
                    </div>
                  </a>
                </div>

                <!-- Publicidad 4: Hotelería & Turismo -->
                <div class="ad-card">
                  <a href="#" class="ad-link" onclick="return false;" title="Auspiciante: Gran Hotel Mercedes">
                    <div class="ad-inner ad-theme-turismo">
                      <span class="ad-micro-label">Auspiciante Oficial</span>
                      <div class="ad-content-box">
                        <span class="ad-icon">🏨</span>
                        <h4 class="ad-brand-name">Gran Hotel Mercedes</h4>
                        <p class="ad-brand-tagline">Confort, descanso y calidez en pleno casco histórico</p>
                      </div>
                      <span class="ad-cta-btn">Reservá Ahora</span>
                    </div>
                  </a>
                </div>

                <!-- Publicidad 5: Agro & Campo Mercedino -->
                <div class="ad-card">
                  <a href="#" class="ad-link" onclick="return false;" title="Auspiciante: Agroservicios La Querencia">
                    <div class="ad-inner ad-theme-agro">
                      <span class="ad-micro-label">Auspiciante Oficial</span>
                      <div class="ad-content-box">
                        <span class="ad-icon">🌾</span>
                        <h4 class="ad-brand-name">La Querencia</h4>
                        <p class="ad-brand-tagline">Insumos rurales y soluciones para el productor agropecuario</p>
                      </div>
                      <span class="ad-cta-btn">Consultá Catálogo</span>
                    </div>
                  </a>
                </div>
              </div>
            </aside>

            {/* 3. SECCIÓN: LO QUE TENÉS QUE SABER (Notas de más de 3 días) */}
            <section 
              class="seccion-archivo" 
              id="seccion-archivo" 
              style={notasLoQueTenesQueSaber.length === 0 ? "display: none;" : ""}
            >
              <div class="section-divider-bar divider-archivo" id="section-archivo-bar">
                <h3 class="section-heading" id="section-archivo-heading">Lo que tenés que saber</h3>
                <div class="section-heading-line"></div>
              </div>

              <div class="lista-archivo" id="lista-archivo">
                {notasLoQueTenesQueSaber.map((nota) => (
                  <article 
                    class="noticia-card is-compact" 
                    id={`card-${nota.slug}`}
                    data-cat={nota.cat}
                    data-is-old="true"
                    data-timestamp={nota.timestamp}
                  >
                    {nota.frontmatter.thumbnail && (
                      <div class="card-media">
                        <a href={`/noticias/${nota.slug}`} class="media-link">
                          <img 
                            src={nota.frontmatter.thumbnail} 
                            alt={cleanTitle(nota.frontmatter.title)} 
                            class="card-img" 
                          />
                        </a>
                      </div>
                    )}

                    <div class="card-content">
                      <div class="meta-row">
                        <span class="fecha">{formatDate(nota.frontmatter.date)}</span>
                        <span class="meta-dot">•</span>
                        <button 
                          type="button" 
                          class="cat-pill-btn" 
                          data-filter-cat={nota.cat}
                          title={`Filtrar por ${CATEGORIAS[nota.cat]}`}
                        >
                          {CATEGORIAS[nota.cat] || 'Actualidad'}
                        </button>
                      </div>

                      <h4 class="card-title">
                        <a href={`/noticias/${nota.slug}`} class="title-link" set:html={formatTitle(nota.frontmatter.title)}></a>
                      </h4>

                      {getExcerpt(nota) && (
                        <p class="card-bajada">
                          {getExcerpt(nota, 140)}
                        </p>
                      )}

                      <a href={`/noticias/${nota.slug}`} class="read-more-link">
                        Leer nota completa <span class="arrow">→</span>
                      </a>
                    </div>
                  </article>
                ))}
              </div>
            </section>

          </div>

          <!-- Mensaje para categoría sin publicaciones -->
          <div class="empty-state-box" id="empty-state-box" hidden>
            <span class="empty-icon">📰</span>
            <h4 class="empty-title">Aún no hay publicaciones en esta sección</h4>
            <p class="empty-text">El equipo de redacción de Mercedes News está preparando notas para este género.</p>
            <button type="button" class="btn-empty-reset" id="btn-empty-reset">
              Ver todas las noticias
            </button>
          </div>

        </section>
      )}

      <!-- Pie de página editorial -->
      <footer class="periodico-footer">
        <div class="footer-divider"></div>
        <div class="footer-content">
          <p class="footer-creditos">
            © {today.getFullYear()} <strong>Mercedes News</strong> — Todos los derechos reservados.
          </p>
          <a href="/admin/" class="footer-admin-link">
            ⚙️ Redacción / CMS
          </a>
        </div>
      </footer>

    </main>

    <!-- Script de interactividad: Header Sticky-Shrink y Filtrado reactivo en ambas secciones -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const headerOuter = document.getElementById('header-outer');
        const header = document.getElementById('main-header');
        const dropdownWrapper = document.getElementById('cat-dropdown-wrapper');
        const dropdownBtn = document.getElementById('cat-dropdown-btn');
        const currentCatName = document.getElementById('current-cat-name');
        const dropdownItems = document.querySelectorAll('.dropdown-item');

        const articulosWrapper = document.getElementById('articulos-wrapper');
        const sectionRecientesBar = document.getElementById('section-recientes-bar');
        const sectionRecientesHeading = document.getElementById('section-recientes-heading');
        const grillaSecundarias = document.getElementById('grilla-secundarias');
        const seccionArchivo = document.getElementById('seccion-archivo');
        const sectionArchivoHeading = document.getElementById('section-archivo-heading');
        const listaArchivo = document.getElementById('lista-archivo');
        const emptyStateBox = document.getElementById('empty-state-box');
        const btnEmptyReset = document.getElementById('btn-empty-reset');

        const CATEGORIAS = {
          'todas': 'Todas',
          'actualidad-local': 'Actualidad Local',
          'actualidad-provincial': 'Actualidad Provincial',
          'actualidad-nacional': 'Actualidad Nacional',
          'deportes': 'Deportes',
          'cronicas': 'Crónicas & Particularidades',
          'entrevistas': 'Mano a Mano',
          'opinion': 'Opinión & Ensayos'
        };

        // Guardamos todas las tarjetas en memoria ordenadas por fecha
        const allCards = Array.from(document.querySelectorAll('.noticia-card'))
          .sort((a, b) => Number(b.dataset.timestamp || 0) - Number(a.dataset.timestamp || 0));

        // Recalcular dinámicamente la antigüedad (> 3 días calendario) en el navegador del lector en tiempo real
        const now = new Date();
        allCards.forEach((card) => {
          const timestamp = Number(card.dataset.timestamp || 0);
          if (timestamp) {
            const target = new Date(timestamp);
            const d1 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const d2 = new Date(target.getFullYear(), target.getMonth(), target.getDate());
            const diffDays = Math.max(0, Math.floor((d1.getTime() - d2.getTime()) / (1000 * 60 * 60 * 24)));
            card.dataset.isOld = diffDays > 3 ? 'true' : 'false';
          }
        });

        // 1. HEADER STICKY-SHRINK: Con posición fija y reserva de altura
        if (headerOuter && header) {
          const updateOuterHeight = () => {
            if (!header.classList.contains('is-scrolled')) {
              headerOuter.style.minHeight = `${header.offsetHeight}px`;
            }
          };
          updateOuterHeight();
          window.addEventListener('resize', updateOuterHeight);

          let isScrolled = false;
          const handleScroll = () => {
            const scrollY = window.scrollY;
            if (!isScrolled && scrollY > 200) {
              isScrolled = true;
              header.classList.add('is-scrolled');
            } else if (isScrolled && scrollY < 120) {
              isScrolled = false;
              header.classList.remove('is-scrolled');
            }
          };

          window.addEventListener('scroll', handleScroll, { passive: true });
          handleScroll();
        }

        // 2. Control del Desplegable (Dropdown)
        function closeDropdown() {
          if (dropdownWrapper) dropdownWrapper.classList.remove('is-open');
          if (dropdownBtn) dropdownBtn.setAttribute('aria-expanded', 'false');
        }

        function toggleDropdown(e) {
          if (e) e.stopPropagation();
          const isOpen = dropdownWrapper.classList.contains('is-open');
          if (isOpen) {
            closeDropdown();
          } else {
            dropdownWrapper.classList.add('is-open');
            dropdownBtn.setAttribute('aria-expanded', 'true');
          }
        }

        if (dropdownBtn) {
          dropdownBtn.addEventListener('click', toggleDropdown);
        }

        document.addEventListener('click', (e) => {
          if (dropdownWrapper && !dropdownWrapper.contains(e.target)) {
            closeDropdown();
          }
        });

        // 3. Filtrado por Categoría (Impacta en portada, secundarias y archivo)
        function applyCategoryFilter(cat) {
          const catName = CATEGORIAS[cat] || 'Todas';
          
          if (currentCatName) currentCatName.textContent = catName;
          
          dropdownItems.forEach((item) => {
            if (item.dataset.cat === cat) {
              item.classList.add('is-selected');
            } else {
              item.classList.remove('is-selected');
            }
          });
          closeDropdown();

          if (cat === 'todas') {
            // MODO "TODAS"
            if (emptyStateBox) emptyStateBox.setAttribute('hidden', '');
            if (articulosWrapper) articulosWrapper.style.display = 'block';

            let countSecundarias = 0;
            let countArchivo = 0;

            allCards.forEach((card, index) => {
              card.style.display = '';
              if (index === 0) {
                card.className = 'noticia-card is-lead';
                if (articulosWrapper && sectionRecientesBar) {
                  articulosWrapper.insertBefore(card, sectionRecientesBar);
                }
              } else if (card.dataset.isOld === 'true') {
                card.className = 'noticia-card is-compact';
                if (listaArchivo) listaArchivo.appendChild(card);
                countArchivo++;
              } else {
                card.className = 'noticia-card is-secondary';
                if (grillaSecundarias) grillaSecundarias.appendChild(card);
                countSecundarias++;
              }
            });

            if (sectionRecientesBar) sectionRecientesBar.style.display = countSecundarias > 0 ? '' : 'none';
            if (sectionRecientesHeading) sectionRecientesHeading.textContent = 'Otras Publicaciones';
            if (grillaSecundarias) grillaSecundarias.style.display = countSecundarias > 0 ? '' : 'none';

            if (seccionArchivo) seccionArchivo.style.display = countArchivo > 0 ? '' : 'none';
            if (sectionArchivoHeading) sectionArchivoHeading.textContent = 'Lo que tenés que saber';
            return;
          }

          // MODO FILTRADO POR CATEGORÍA
          const matchingCards = allCards.filter((card) => card.dataset.cat === cat);

          if (matchingCards.length === 0) {
            if (articulosWrapper) articulosWrapper.style.display = 'none';
            if (emptyStateBox) emptyStateBox.removeAttribute('hidden');
            return;
          }

          if (emptyStateBox) emptyStateBox.setAttribute('hidden', '');
          if (articulosWrapper) articulosWrapper.style.display = 'block';

          // Ocultar tarjetas de otras categorías
          allCards.forEach((card) => {
            if (card.dataset.cat !== cat) {
              card.style.display = 'none';
            } else {
              card.style.display = '';
            }
          });

          // La primera nota de la categoría se promueve a NOTA DE TAPA
          const leadCard = matchingCards[0];
          leadCard.className = 'noticia-card is-lead';
          if (articulosWrapper && sectionRecientesBar) {
            articulosWrapper.insertBefore(leadCard, sectionRecientesBar);
          }

          // Las demás se distribuyen según antigüedad (> 3 días)
          const restCards = matchingCards.slice(1);
          let countSecundarias = 0;
          let countArchivo = 0;

          restCards.forEach((card) => {
            if (card.dataset.isOld === 'true') {
              card.className = 'noticia-card is-compact';
              if (listaArchivo) listaArchivo.appendChild(card);
              countArchivo++;
            } else {
              card.className = 'noticia-card is-secondary';
              if (grillaSecundarias) grillaSecundarias.appendChild(card);
              countSecundarias++;
            }
          });

          if (sectionRecientesBar) sectionRecientesBar.style.display = countSecundarias > 0 ? '' : 'none';
          if (sectionRecientesHeading) sectionRecientesHeading.textContent = `Más en ${catName}`;
          if (grillaSecundarias) grillaSecundarias.style.display = countSecundarias > 0 ? '' : 'none';

          if (seccionArchivo) seccionArchivo.style.display = countArchivo > 0 ? '' : 'none';
          if (sectionArchivoHeading) sectionArchivoHeading.textContent = `Lo que tenés que saber en ${catName}`;
        }

        // Clicks en opciones del menú desplegable
        dropdownItems.forEach((item) => {
          item.addEventListener('click', () => {
            const cat = item.dataset.cat || 'todas';
            applyCategoryFilter(cat);
          });
        });

        // Botón de reset en pantalla vacía
        if (btnEmptyReset) {
          btnEmptyReset.addEventListener('click', () => applyCategoryFilter('todas'));
        }

        // Clicks en las píldoras de categoría al lado de la fecha
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-filter-cat]');
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            const cat = btn.dataset.filterCat;
            if (cat) {
              applyCategoryFilter(cat);
              const layout = document.getElementById('noticias-section');
              if (layout) {
                layout.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          }
        });

        // Soporte para URL parameter `?cat=...` o inicialización automática con 'todas'
        const urlParams = new URLSearchParams(window.location.search);
        const catFromUrl = urlParams.get('cat');
        if (catFromUrl && CATEGORIAS[catFromUrl]) {
          applyCategoryFilter(catFromUrl);
        } else {
          applyCategoryFilter('todas');
        }
      });
    </script>
  </body>
</html>

