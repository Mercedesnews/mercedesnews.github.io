// Cargamos todas las noticias de la carpeta content/noticias
const rawNotas = Object.values(import.meta.glob('../content/noticias/*.md', { eager: true }));

// Cargamos las publicidades activas de content/publicidades
const rawPublicidades = Object.values(import.meta.glob('../content/publicidades/*.md', { eager: true }));
const publicidades = rawPublicidades
  .map((p: any) => p.frontmatter)
  .filter((p: any) => p && p.activo !== false)
  .sort((a: any, b: any) => (Number(a.orden) || 99) - (Number(b.orden) || 99));

// Mapa de categorías oficiales
const CATEGORIAS: Record<string, string> = {
  'actualidad-local': 'Actualidad Local',
  'actualidad-provincial': 'Actualidad Provincial',
  'actualidad-nacional': 'Actualidad Nacional',
  'deportes': 'Deportes',
  'cronicas': 'Crónicas & Particularidades',
  'entrevistas': 'Mano a Mano',
  'opinion': 'Opinión & Ensayos'
};

// Función para calcular diferencia en días calendario
function getCalendarDaysDiff(dateString) {
  if (!dateString) return 0;
  const now = new Date();
  const target = new Date(dateString);
  const d1 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const d2 = new Date(target.getFullYear(), target.getMonth(), target.getDate());
  const diffTime = d1.getTime() - d2.getTime();
  return Math.max(0, Math.floor(diffTime / (1000 * 60 * 60 * 24)));
}

// Cargamos la configuración de portada si existe (tarea0017)
let notaDeTapaSlug = '';
try {
  const modPortada = await import('../content/configuracion/portada.json');
  notaDeTapaSlug = (modPortada.default?.nota_de_tapa || modPortada.nota_de_tapa || '').trim();
} catch (e) {
  // archivo aún no creado
}

// Mapeamos y procesamos todas las notas con pin y orden
const notas = rawNotas
  .map((nota: any) => {
    const slug = nota.file.split('/').pop().replace('.md', '');
    const cat = nota.frontmatter.categoria || 'actualidad-local';
    const daysAgo = getCalendarDaysDiff(nota.frontmatter.date);
    const pin = Boolean(nota.frontmatter.pin);
    const rawOrden = nota.frontmatter.orden;
    const orden = (rawOrden !== undefined && rawOrden !== null && rawOrden !== '') 
      ? Number(rawOrden) 
      : null;
    // Si tiene pin, NUNCA pasa al archivo automático aunque hayan pasado más de 3 días
    const isOld = daysAgo > 3 && !pin;
    const timestamp = new Date(nota.frontmatter.date).getTime();
    return { ...nota, slug, cat, daysAgo, pin, orden, isOld, timestamp };
  })
  .sort((a, b) => b.timestamp - a.timestamp);

// Determinamos la Nota de Tapa (tarea0017)
// Si el administrador eligió una nota específica en portada.json, esa lidera.
// Si no, fallback a la nota más reciente por fecha.
let leadNota: any;
let restNotas: any[];

const foundIndex = notaDeTapaSlug ? notas.findIndex((n) => n.slug === notaDeTapaSlug) : -1;
if (foundIndex !== -1) {
  leadNota = { ...notas[foundIndex], isTapa: true, isOld: false };
  restNotas = notas.filter((_, idx) => idx !== foundIndex);
} else {
  leadNota = { ...notas[0], isTapa: true, isOld: false };
  restNotas = notas.slice(1);
}

// Separamos en secundarias recientes (incluye notas con pin) y archivo (> 3 días y sin pin)
const secundariasRecientes = restNotas.filter((n) => !n.isOld);
const notasLoQueTenesQueSaber = restNotas.filter((n) => n.isOld);

// Función de ordenamiento para notas secundarias recientes:
// 1. Las notas con número de orden van primero (orden asc: 1, 2, 3...)
//    En caso de empate en orden, desempata la más reciente (timestamp desc)
// 2. Las notas sin número de orden van abajo, ordenadas cronológicamente por fecha (timestamp desc)
function sortNotasRecientes(a: any, b: any) {
  const hasA = a.orden !== null && !isNaN(a.orden);
  const hasB = b.orden !== null && !isNaN(b.orden);
  if (hasA && hasB) {
    if (a.orden !== b.orden) return a.orden - b.orden;
    return b.timestamp - a.timestamp;
  }
  if (hasA) return -1;
  if (hasB) return 1;
  return b.timestamp - a.timestamp;
}

secundariasRecientes.sort(sortNotasRecientes);

// En "Lo que tenés que saber" el orden es estricta y puramente cronológico descendente
notasLoQueTenesQueSaber.sort((a: any, b: any) => b.timestamp - a.timestamp);

// Función para formatear fechas al estilo editorial
function formatDate(dateString) {
  if (!dateString) return '';
  const d = new Date(dateString);
  return `${d.getDate()} ${d.toLocaleString('es-AR', { month: 'long' })}, ${d.getFullYear()}`;
}

// Función para parsear títulos: Línea 1 = Título (Poppins Bold), Líneas siguientes = Subtítulo (Poppins Light)
function formatTitle(rawTitle) {
  if (!rawTitle) return '';
  const lines = rawTitle
    .replace(/(\*\*|\*|_|`)/g, '')
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  if (lines.length === 0) return '';
  const title = lines[0];
  const subtitle = lines.slice(1).join('<br/>');

  if (!subtitle) {
    return `<span class="titulo-principal">${title}</span>`;
  }
  return `<span class="titulo-principal">${title}</span><span class="subtitulo-nota">${subtitle}</span>`;
}

// Función para obtener sólo el primer renglón limpio sin formato para alt y meta
function cleanTitle(rawTitle) {
  if (!rawTitle) return '';
  const firstLine = rawTitle.split(/\r?\n/)[0] || '';
  return firstLine.replace(/(\*\*|\*|_|`)/g, '').trim();
}

// Función para extraer un extracto limpio de texto para la bajada
function getExcerpt(nota, maxLength = 160) {
  const raw = typeof nota.rawContent === 'function' ? nota.rawContent() : '';
  const clean = raw
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/#{1,6}\s+/g, '')
    .replace(/(\*\*|\*|_|`)/g, '')
    .replace(/\n+/g, ' ')
    .trim();
  
  if (clean.length <= maxLength) return clean;
  return clean.slice(0, maxLength).trim() + '…';
}

const today = new Date();
const fechaHoy = today.toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Índice serializado de búsqueda para la tarea0003
const searchIndex = notas.map((n) => {
  const rawTitle = (n.frontmatter.title || '').replace(/(\*\*|\*|_|`)/g, '');
  const lines = rawTitle.split(/\r?\n/).map((l) => l.trim()).filter((l) => l.length > 0);
  const title = lines[0] || '';
  const subtitle = lines.slice(1).join(' ') || '';
  return {
    slug: n.slug,
    title,
    subtitle,
    date: formatDate(n.frontmatter.date),
    cat: n.cat,
    catName: CATEGORIAS[n.cat] || 'Actualidad',
    thumbnail: n.frontmatter.thumbnail || '',
    excerpt: getExcerpt(n, 140)
  };
});
