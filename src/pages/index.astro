    <!-- Script de interactividad: Header Sticky-Shrink y Filtrado reactivo en ambas secciones -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const headerOuter = document.getElementById('header-outer');
        const header = document.getElementById('main-header');
        const dropdownWrapper = document.getElementById('cat-dropdown-wrapper');
        const dropdownBtn = document.getElementById('cat-dropdown-btn');
        const currentCatName = document.getElementById('current-cat-name');
        const dropdownItems = document.querySelectorAll('.dropdown-item');

        const articulosWrapper = document.getElementById('articulos-wrapper');
        const sectionRecientesBar = document.getElementById('section-recientes-bar');
        const sectionRecientesHeading = document.getElementById('section-recientes-heading');
        const grillaSecundarias = document.getElementById('grilla-secundarias');
        const seccionArchivo = document.getElementById('seccion-archivo');
        const sectionArchivoHeading = document.getElementById('section-archivo-heading');
        const listaArchivo = document.getElementById('lista-archivo');
        const emptyStateBox = document.getElementById('empty-state-box');
        const btnEmptyReset = document.getElementById('btn-empty-reset');

        const CATEGORIAS = {
          'todas': 'Todas',
          'actualidad-local': 'Actualidad Local',
          'actualidad-provincial': 'Actualidad Provincial',
          'actualidad-nacional': 'Actualidad Nacional',
          'deportes': 'Deportes',
          'cronicas': 'Crónicas & Particularidades',
          'entrevistas': 'Mano a Mano',
          'opinion': 'Opinión & Ensayos'
        };

        // Guardamos todas las tarjetas en memoria
        const allCards = Array.from(document.querySelectorAll('.noticia-card'));

        // Recalcular dinámicamente la antigüedad (> 3 días calendario) en el navegador del lector en tiempo real
        const now = new Date();
        allCards.forEach((card) => {
          const timestamp = Number(card.dataset.timestamp || 0);
          const isPinned = card.dataset.pin === 'true';
          const isTapa = card.dataset.isTapa === 'true';
          if (timestamp) {
            const target = new Date(timestamp);
            const d1 = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const d2 = new Date(target.getFullYear(), target.getMonth(), target.getDate());
            const diffDays = Math.max(0, Math.floor((d1.getTime() - d2.getTime()) / (1000 * 60 * 60 * 24)));
            // Si tiene pin o es la tapa oficial, NUNCA va al archivo automático
            card.dataset.isOld = (diffDays > 3 && !isPinned && !isTapa) ? 'true' : 'false';
          }
        });

        // Funciones auxiliares de ordenamiento:
        // 1. Para secundarias recientes: con orden numérico asc (1, 2, 3...) primero, desempate por fecha desc; sin orden numérico abajo por fecha desc.
        function sortCardsRecientes(cards) {
          return cards.slice().sort((a, b) => {
            const rawA = a.dataset.orden;
            const rawB = b.dataset.orden;
            const ordenA = rawA !== '' && rawA !== undefined ? Number(rawA) : null;
            const ordenB = rawB !== '' && rawB !== undefined ? Number(rawB) : null;
            const hasA = ordenA !== null && !isNaN(ordenA);
            const hasB = ordenB !== null && !isNaN(ordenB);
            const timeA = Number(a.dataset.timestamp || 0);
            const timeB = Number(b.dataset.timestamp || 0);

            if (hasA && hasB) {
              if (ordenA !== ordenB) return ordenA - ordenB;
              return timeB - timeA;
            }
            if (hasA) return -1;
            if (hasB) return 1;
            return timeB - timeA;
          });
        }

        // 2. Para archivo "Lo que tenés que saber": puramente cronológico descendente
        function sortCardsArchivo(cards) {
          return cards.slice().sort((a, b) => {
            const timeA = Number(a.dataset.timestamp || 0);
            const timeB = Number(b.dataset.timestamp || 0);
            return timeB - timeA;
          });
        }

        // 1. HEADER STICKY-SHRINK: Con posición fija y reserva de altura
        if (headerOuter && header) {
          const updateOuterHeight = () => {
            if (!header.classList.contains('is-scrolled')) {
              headerOuter.style.minHeight = `${header.offsetHeight}px`;
            }
          };
          updateOuterHeight();
          window.addEventListener('resize', updateOuterHeight);

          let isScrolled = false;
          const handleScroll = () => {
            const scrollY = window.scrollY;
            if (!isScrolled && scrollY > 200) {
              isScrolled = true;
              header.classList.add('is-scrolled');
            } else if (isScrolled && scrollY < 120) {
              isScrolled = false;
              header.classList.remove('is-scrolled');
            }
          };

          window.addEventListener('scroll', handleScroll, { passive: true });
          handleScroll();
        }

        // 2. Control del Desplegable (Dropdown)
        function closeDropdown() {
          if (dropdownWrapper) dropdownWrapper.classList.remove('is-open');
          if (dropdownBtn) dropdownBtn.setAttribute('aria-expanded', 'false');
        }

        function toggleDropdown(e) {
          if (e) e.stopPropagation();
          const isOpen = dropdownWrapper.classList.contains('is-open');
          if (isOpen) {
            closeDropdown();
          } else {
            dropdownWrapper.classList.add('is-open');
            dropdownBtn.setAttribute('aria-expanded', 'true');
          }
        }

        if (dropdownBtn) {
          dropdownBtn.addEventListener('click', toggleDropdown);
        }

        document.addEventListener('click', (e) => {
          if (dropdownWrapper && !dropdownWrapper.contains(e.target)) {
            closeDropdown();
          }
        });

        // 3. Filtrado por Categoría (Impacta en portada, secundarias y archivo)
        function applyCategoryFilter(cat) {
          const catName = CATEGORIAS[cat] || 'Todas';
          
          if (currentCatName) currentCatName.textContent = catName;
          
          dropdownItems.forEach((item) => {
            if (item.dataset.cat === cat) {
              item.classList.add('is-selected');
            } else {
              item.classList.remove('is-selected');
            }
          });
          closeDropdown();

          if (cat === 'todas') {
            // MODO "TODAS"
            if (emptyStateBox) emptyStateBox.setAttribute('hidden', '');
            if (articulosWrapper) articulosWrapper.style.display = 'block';

            // Tarjeta de Tapa general: la que tenga data-is-tapa="true" o la más reciente
            const leadCard = allCards.find((c) => c.dataset.isTapa === 'true') 
              || allCards.slice().sort((a, b) => Number(b.dataset.timestamp || 0) - Number(a.dataset.timestamp || 0))[0];

            const restCards = allCards.filter((c) => c !== leadCard);
            const secundarias = sortCardsRecientes(restCards.filter((c) => c.dataset.isOld !== 'true'));
            const archivo = sortCardsArchivo(restCards.filter((c) => c.dataset.isOld === 'true'));

            allCards.forEach((card) => {
              card.style.display = '';
            });

            leadCard.className = 'noticia-card is-lead';
            if (articulosWrapper && sectionRecientesBar) {
              articulosWrapper.insertBefore(leadCard, sectionRecientesBar);
            }

            if (grillaSecundarias) {
              secundarias.forEach((card) => {
                card.className = 'noticia-card is-secondary';
                grillaSecundarias.appendChild(card);
              });
            }

            if (listaArchivo) {
              archivo.forEach((card) => {
                card.className = 'noticia-card is-compact';
                listaArchivo.appendChild(card);
              });
            }

            if (sectionRecientesBar) sectionRecientesBar.style.display = secundarias.length > 0 ? '' : 'none';
            if (sectionRecientesHeading) sectionRecientesHeading.textContent = 'Otras Publicaciones';
            if (grillaSecundarias) grillaSecundarias.style.display = secundarias.length > 0 ? '' : 'none';

            if (seccionArchivo) seccionArchivo.style.display = archivo.length > 0 ? '' : 'none';
            if (sectionArchivoHeading) sectionArchivoHeading.textContent = 'Lo que tenés que saber';
            return;
          }

          // MODO FILTRADO POR CATEGORÍA
          const matchingCards = allCards.filter((card) => card.dataset.cat === cat);

          if (matchingCards.length === 0) {
            if (articulosWrapper) articulosWrapper.style.display = 'none';
            if (emptyStateBox) emptyStateBox.removeAttribute('hidden');
            return;
          }

          if (emptyStateBox) emptyStateBox.setAttribute('hidden', '');
          if (articulosWrapper) articulosWrapper.style.display = 'block';

          // Ocultar tarjetas de otras categorías
          allCards.forEach((card) => {
            if (card.dataset.cat !== cat) {
              card.style.display = 'none';
            } else {
              card.style.display = '';
            }
          });

          // Regla tarea0017:
          // Si la nota de tapa general pertenece a esta categoría, se mantiene como tapa.
          // Si no, lidera la de posición más alta (orden menor), o si no están numeradas, la más reciente.
          let leadCard = matchingCards.find((c) => c.dataset.isTapa === 'true');
          if (!leadCard) {
            leadCard = sortCardsRecientes(matchingCards)[0];
          }

          leadCard.className = 'noticia-card is-lead';
          if (articulosWrapper && sectionRecientesBar) {
            articulosWrapper.insertBefore(leadCard, sectionRecientesBar);
          }

          const restCards = matchingCards.filter((c) => c !== leadCard);
          const secundarias = sortCardsRecientes(restCards.filter((c) => c.dataset.isOld !== 'true'));
          const archivo = sortCardsArchivo(restCards.filter((c) => c.dataset.isOld === 'true'));

          if (grillaSecundarias) {
            secundarias.forEach((card) => {
              card.className = 'noticia-card is-secondary';
              grillaSecundarias.appendChild(card);
            });
          }

          if (listaArchivo) {
            archivo.forEach((card) => {
              card.className = 'noticia-card is-compact';
              listaArchivo.appendChild(card);
            });
          }

          if (sectionRecientesBar) sectionRecientesBar.style.display = secundarias.length > 0 ? '' : 'none';
          if (sectionRecientesHeading) sectionRecientesHeading.textContent = `Más en ${catName}`;
          if (grillaSecundarias) grillaSecundarias.style.display = secundarias.length > 0 ? '' : 'none';

          if (seccionArchivo) seccionArchivo.style.display = archivo.length > 0 ? '' : 'none';
          if (sectionArchivoHeading) sectionArchivoHeading.textContent = `Lo que tenés que saber en ${catName}`;
        }

        // Clicks en opciones del menú desplegable
        dropdownItems.forEach((item) => {
          item.addEventListener('click', () => {
            const cat = item.dataset.cat || 'todas';
            applyCategoryFilter(cat);
          });
        });

        // Botón de reset en pantalla vacía
        if (btnEmptyReset) {
          btnEmptyReset.addEventListener('click', () => applyCategoryFilter('todas'));
        }

        // Clicks en las píldoras de categoría al lado de la fecha
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-filter-cat]');
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            const cat = btn.dataset.filterCat;
            if (cat) {
              applyCategoryFilter(cat);
              const layout = document.getElementById('noticias-section');
              if (layout) {
                layout.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          }
        });

        // Soporte para URL parameter `?cat=...` o inicialización automática con 'todas'
        const urlParams = new URLSearchParams(window.location.search);
        const catFromUrl = urlParams.get('cat');
        if (catFromUrl && CATEGORIAS[catFromUrl]) {
          applyCategoryFilter(catFromUrl);
        } else {
          applyCategoryFilter('todas');
        }

        // ========================================================
        // TAREA0004: CLIMA DINÁMICO (Mercedes, Buenos Aires)
        // ========================================================
        async function loadMercedesWeather() {
          const iconEl = document.getElementById('weather-icon');
          const tempEl = document.getElementById('weather-temp');
          const descEl = document.getElementById('weather-popover-desc');
          const popIconEl = document.getElementById('weather-popover-icon');
          const popTempEl = document.getElementById('weather-popover-temp');
          const minmaxEl = document.getElementById('weather-popover-minmax');
          const humidityEl = document.getElementById('weather-popover-humidity');
          const windEl = document.getElementById('weather-popover-wind');
          const widget = document.getElementById('weather-widget');

          if (!iconEl || !tempEl) return;

          // Toggle popover en click (para dispositivos táctiles y móviles)
          if (widget) {
            widget.addEventListener('click', (e) => {
              e.stopPropagation();
              widget.classList.toggle('is-active');
            });
            document.addEventListener('click', (e) => {
              if (!widget.contains(e.target)) {
                widget.classList.remove('is-active');
              }
            });
          }

          const CACHE_KEY = 'mn_weather_mercedes';
          const CACHE_TTL = 30 * 60 * 1000; // 30 minutos

          let weatherData = null;
          try {
            const cached = sessionStorage.getItem(CACHE_KEY);
            if (cached) {
              const parsed = JSON.parse(cached);
              if (Date.now() - parsed.timestamp < CACHE_TTL) {
                weatherData = parsed.data;
              }
            }
          } catch (e) {}

          if (!weatherData) {
            try {
              const res = await fetch(
                'https://api.open-meteo.com/v1/forecast?latitude=-34.6514&longitude=-59.4307&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m&daily=temperature_2m_max,temperature_2m_min&timezone=America%2FArgentina%2FBuenos_Aires'
              );
              if (!res.ok) throw new Error('Error al consultar Open-Meteo');
              weatherData = await res.json();
              try {
                sessionStorage.setItem(CACHE_KEY, JSON.stringify({ data: weatherData, timestamp: Date.now() }));
              } catch (e) {}
            } catch (err) {
              console.warn('Clima no disponible:', err);
              tempEl.textContent = '19°';
              return;
            }
          }

          function parseWmo(code) {
            if (code === 0) return { icon: '☀️', text: 'Despejado' };
            if (code === 1 || code === 2) return { icon: '🌤️', text: 'Algo nublado' };
            if (code === 3) return { icon: '☁️', text: 'Nublado' };
            if (code === 45 || code === 48) return { icon: '🌫️', text: 'Niebla / Neblina' };
            if (code >= 51 && code <= 55) return { icon: '🌦️', text: 'Llovizna' };
            if (code >= 61 && code <= 67) return { icon: '🌧️', text: 'Lluvia' };
            if (code >= 71 && code <= 77) return { icon: '🌨️', text: 'Nevada' };
            if (code >= 80 && code <= 82) return { icon: '🌧️', text: 'Chubascos' };
            if (code >= 95 && code <= 99) return { icon: '⛈️', text: 'Tormenta eléctrica' };
            return { icon: '⛅', text: 'Parcialmente nublado' };
          }

          const current = weatherData?.current;
          const daily = weatherData?.daily;
          const wmo = parseWmo(current?.weather_code ?? 1);
          const temp = Math.round(current?.temperature_2m ?? 20);

          iconEl.textContent = wmo.icon;
          tempEl.textContent = `${temp}°`;

          if (popIconEl) popIconEl.textContent = wmo.icon;
          if (popTempEl) popTempEl.textContent = `${temp}°C`;
          if (descEl) descEl.textContent = wmo.text;
          if (minmaxEl && daily?.temperature_2m_min && daily?.temperature_2m_max) {
            const min = Math.round(daily.temperature_2m_min[0]);
            const max = Math.round(daily.temperature_2m_max[0]);
            minmaxEl.textContent = `${min}° / ${max}°`;
          }
          if (humidityEl && current?.relative_humidity_2m !== undefined) {
            humidityEl.textContent = `${current.relative_humidity_2m}%`;
          }
          if (windEl && current?.wind_speed_10m !== undefined) {
            windEl.textContent = `${Math.round(current.wind_speed_10m)} km/h`;
          }
        }

        // ========================================================
        // TAREA0003: BUSCADOR INTERACTIVO INDEXADO
        // ========================================================
        function initSearchModal() {
          const modal = document.getElementById('search-modal');
          const input = document.getElementById('search-input');
          const closeBtn = document.getElementById('search-modal-close');
          const resultsEl = document.getElementById('search-modal-results');
          const countEl = document.getElementById('search-results-count');
          const triggerBtn = document.getElementById('search-trigger-btn');
          const stickyTriggerBtn = document.getElementById('sticky-search-btn');
          const searchDataEl = document.getElementById('search-data');

          if (!modal || !input || !searchDataEl) return;

          let items = [];
          try {
            items = JSON.parse(searchDataEl.textContent || '[]');
          } catch (e) {}

          function openSearch() {
            modal.removeAttribute('hidden');
            modal.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
            input.value = '';
            renderResults('');
            setTimeout(() => input.focus(), 50);
          }

          function closeSearch() {
            modal.setAttribute('hidden', '');
            modal.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }

          if (triggerBtn) triggerBtn.addEventListener('click', openSearch);
          if (stickyTriggerBtn) stickyTriggerBtn.addEventListener('click', openSearch);
          if (closeBtn) closeBtn.addEventListener('click', closeSearch);

          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeSearch();
          });

          document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
              e.preventDefault();
              modal.hasAttribute('hidden') ? openSearch() : closeSearch();
            } else if (e.key === 'Escape' && !modal.hasAttribute('hidden')) {
              closeSearch();
            }
          });

          function normalizeStr(str) {
            return (str || '')
              .toLowerCase()
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '');
          }

          function highlightMatches(text, query) {
            if (!query || !text) return text;
            const normText = normalizeStr(text);
            const normQuery = normalizeStr(query);
            const idx = normText.indexOf(normQuery);
            if (idx === -1) return text;
            const before = text.slice(0, idx);
            const match = text.slice(idx, idx + query.length);
            const after = text.slice(idx + query.length);
            return `${before}<mark class="search-highlight">${match}</mark>${after}`;
          }

          function renderResults(queryRaw) {
            const query = queryRaw.trim();
            if (!query) {
              if (countEl) countEl.textContent = `${items.length} publicaciones`;
              resultsEl.innerHTML = `
                <div class="search-empty-prompt">
                  <p class="prompt-title">Escribí para buscar noticias en tiempo real</p>
                  <p class="prompt-sub">Podés buscar por títulos, temas o palabras clave.</p>
                </div>
              `;
              return;
            }

            const normQuery = normalizeStr(query);
            const matches = items.filter((item) => {
              return (
                normalizeStr(item.title).includes(normQuery) ||
                normalizeStr(item.subtitle).includes(normQuery) ||
                normalizeStr(item.catName).includes(normQuery) ||
                normalizeStr(item.excerpt).includes(normQuery)
              );
            });

            if (countEl) {
              countEl.textContent = `${matches.length} ${matches.length === 1 ? 'coincidencia' : 'coincidencias'}`;
            }

            if (matches.length === 0) {
              resultsEl.innerHTML = `
                <div class="search-no-results">
                  <span class="no-results-icon">🔎</span>
                  <p class="no-results-title">No encontramos noticias para "<strong>${query}</strong>"</p>
                  <p class="no-results-sub">Probá buscando con otras palabras o términos más generales.</p>
                </div>
              `;
              return;
            }

            resultsEl.innerHTML = matches
              .map(
                (item) => `
              <a href="/noticias/${item.slug}" class="search-result-item">
                ${
                  item.thumbnail
                    ? `<img src="${item.thumbnail}" alt="" class="search-result-thumb" />`
                    : `<div class="search-result-thumb placeholder">📰</div>`
                }
                <div class="search-result-info">
                  <div class="search-result-meta">
                    <span class="search-result-cat">${item.catName}</span>
                    <span class="search-result-dot">•</span>
                    <span class="search-result-date">${item.date}</span>
                  </div>
                  <h4 class="search-result-title">${highlightMatches(item.title, query)}</h4>
                  ${item.subtitle ? `<p class="search-result-subtitle">${highlightMatches(item.subtitle, query)}</p>` : ''}
                </div>
              </a>
            `
              )
              .join('');
          }

          input.addEventListener('input', (e) => {
            renderResults(e.target.value);
          });
        }

        // Inicializamos clima y buscador
        loadMercedesWeather();
        initSearchModal();
      });
    </script>
  </body>
</html>

