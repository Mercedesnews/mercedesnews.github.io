---
// Cargamos todas las noticias de la carpeta content/noticias
const rawNotas = Object.values(import.meta.glob('../content/noticias/*.md', { eager: true }));

// Mapa de categorías oficiales
const CATEGORIAS: Record<string, string> = {
  'actualidad-local': 'Actualidad Local',
  'cronicas': 'Crónicas & Particularidades',
  'entrevistas': 'Mano a Mano',
  'opinion': 'Opinión & Ensayos'
};

// Ordenamos las notas por fecha de forma descendente (la más reciente primero)
const notas = rawNotas
  .map((nota) => {
    const slug = nota.file.split('/').pop().replace('.md', '');
    const cat = nota.frontmatter.categoria || 'actualidad-local';
    return { ...nota, slug, cat };
  })
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime());

// Función para formatear fechas al estilo editorial
function formatDate(dateString) {
  if (!dateString) return '';
  const d = new Date(dateString);
  return `${d.getDate()} ${d.toLocaleString('es-AR', { month: 'long' })}, ${d.getFullYear()}`;
}

// Función para parsear títulos: Línea 1 = Título (Poppins Bold), Líneas siguientes = Subtítulo (Poppins Light)
function formatTitle(rawTitle) {
  if (!rawTitle) return '';
  const lines = rawTitle
    .replace(/(\*\*|\*|_|`)/g, '')
    .split(/\r?\n/)
    .map((l) => l.trim())
    .filter((l) => l.length > 0);

  if (lines.length === 0) return '';
  const title = lines[0];
  const subtitle = lines.slice(1).join('<br/>');

  if (!subtitle) {
    return `<span class="titulo-principal">${title}</span>`;
  }
  return `<span class="titulo-principal">${title}</span><span class="subtitulo-nota">${subtitle}</span>`;
}

// Función para obtener sólo el primer renglón limpio sin formato para alt y meta
function cleanTitle(rawTitle) {
  if (!rawTitle) return '';
  const firstLine = rawTitle.split(/\r?\n/)[0] || '';
  return firstLine.replace(/(\*\*|\*|_|`)/g, '').trim();
}

// Función para extraer un extracto limpio de texto para la bajada
function getExcerpt(nota, maxLength = 160) {
  const raw = typeof nota.rawContent === 'function' ? nota.rawContent() : '';
  const clean = raw
    .replace(/!\[.*?\]\(.*?\)/g, '')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/#{1,6}\s+/g, '')
    .replace(/(\*\*|\*|_|`)/g, '')
    .replace(/\n+/g, ' ')
    .trim();
  
  if (clean.length <= maxLength) return clean;
  return clean.slice(0, maxLength).trim() + '…';
}

const today = new Date();
const fechaHoy = today.toLocaleDateString('es-AR', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mercedes News — Diario Digital</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Archivo:ital,wdth,wght@1,125,900&family=Montserrat:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:ital,wght@0,100;0,200;0,300;0,700;1,100;1,200;1,300;1,700&display=swap" rel="stylesheet">
  </head>
  <body>

    <!-- Contenedor exterior del header para evitar saltos o rebotes de layout en scroll -->
    <div class="header-outer" id="header-outer">
      <header class="periodico-header" id="main-header">
        <div class="header-container">
          
          <!-- Barra superior: fecha y localidad (se oculta al scrollear) -->
          <div class="top-bar">
            <span class="top-date">{fechaHoy}</span>
            <span class="top-edition">Edición Digital</span>
            <span class="top-location">Mercedes, Buenos Aires</span>
          </div>

          <!-- Área principal de Cabecera -->
          <div class="masthead-area">
            <div class="brand-box">
              <a href="/" class="brand-link">
                <h1 class="diario-title">MERCEDES NEWS</h1>
              </a>
              <p class="diario-lema">«El portal de noticias hecho para vos»</p>
            </div>

            <!-- Selector desplegable de Categorías -->
            <div class="category-filter-box">
              <div class="dropdown-wrapper" id="cat-dropdown-wrapper">
                <button 
                  type="button" 
                  class="dropdown-trigger-btn" 
                  id="cat-dropdown-btn" 
                  aria-expanded="false"
                >
                  <span class="trigger-label">SECCIÓN:</span>
                  <span class="trigger-value" id="current-cat-name">Todas</span>
                  <span class="trigger-arrow">▾</span>
                </button>
                
                <ul class="dropdown-list" id="cat-dropdown-list">
                  <li data-cat="todas" class="dropdown-item is-selected">Todas las secciones</li>
                  <li data-cat="actualidad-local" class="dropdown-item">Actualidad Local</li>
                  <li data-cat="cronicas" class="dropdown-item">Crónicas &amp; Particularidades</li>
                  <li data-cat="entrevistas" class="dropdown-item">Mano a Mano</li>
                  <li data-cat="opinion" class="dropdown-item">Opinión &amp; Ensayos</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Doble pleca azul divisoria -->
          <div class="header-divider"></div>
        </div>
      </header>
    </div>

    <main class="index-container">

      {notas.length === 0 ? (
        <div class="sin-noticias">
          <p>No hay noticias publicadas en este momento.</p>
        </div>
      ) : (
        <section class="noticias-section" id="noticias-section">

          <!-- Contenedor único de noticias -->
          <div class="articulos-wrapper" id="articulos-wrapper">
            
            {/* Nota de Tapa Inicial (Primera nota) */}
            {notas[0] && (
              <article 
                class="noticia-card is-lead" 
                id={`card-${notas[0].slug}`}
                data-cat={notas[0].cat}
              >
                {notas[0].frontmatter.thumbnail && (
                  <div class="card-media">
                    <a href={`/noticias/${notas[0].slug}`} class="media-link">
                      <img 
                        src={notas[0].frontmatter.thumbnail} 
                        alt={cleanTitle(notas[0].frontmatter.title)} 
                        class="card-img" 
                      />
                      <span class="badge-tapa">Tapa</span>
                      <span class="badge-cat">{CATEGORIAS[notas[0].cat] || 'Actualidad'}</span>
                    </a>
                  </div>
                )}

                <div class="card-content">
                  <div class="meta-row">
                    <span class="fecha">{formatDate(notas[0].frontmatter.date)}</span>
                    <span class="meta-dot">•</span>
                    <button 
                      type="button" 
                      class="cat-pill-btn" 
                      data-filter-cat={notas[0].cat}
                      title={`Filtrar por ${CATEGORIAS[notas[0].cat]}`}
                    >
                      {CATEGORIAS[notas[0].cat] || 'Actualidad'}
                    </button>
                  </div>

                  <h2 class="card-title">
                    <a href={`/noticias/${notas[0].slug}`} class="title-link" set:html={formatTitle(notas[0].frontmatter.title)}></a>
                  </h2>

                  {getExcerpt(notas[0]) && (
                    <p class="card-bajada">
                      {getExcerpt(notas[0], 220)}
                    </p>
                  )}

                  <a href={`/noticias/${notas[0].slug}`} class="read-more-link">
                    Leer nota completa <span class="arrow">→</span>
                  </a>
                </div>
              </article>
            )}

            {/* Separador de Sección (Otras Publicaciones) */}
            {notas.length > 1 && (
              <div class="section-divider-bar" id="section-divider-bar">
                <h3 class="section-heading" id="section-heading-text">Otras Publicaciones</h3>
                <div class="section-heading-line"></div>
              </div>
            )}

            {/* Grilla de Notas Secundarias */}
            <div class="grilla-secundarias" id="grilla-secundarias">
              {notas.slice(1).map((nota) => (
                <article 
                  class="noticia-card is-secondary" 
                  id={`card-${nota.slug}`}
                  data-cat={nota.cat}
                >
                  {nota.frontmatter.thumbnail && (
                    <div class="card-media">
                      <a href={`/noticias/${nota.slug}`} class="media-link">
                        <img 
                          src={nota.frontmatter.thumbnail} 
                          alt={cleanTitle(nota.frontmatter.title)} 
                          class="card-img" 
                        />
                        <span class="badge-cat">{CATEGORIAS[nota.cat] || 'Actualidad'}</span>
                      </a>
                    </div>
                  )}

                  <div class="card-content">
                    <div class="meta-row">
                      <span class="fecha">{formatDate(nota.frontmatter.date)}</span>
                      <span class="meta-dot">•</span>
                      <button 
                        type="button" 
                        class="cat-pill-btn" 
                        data-filter-cat={nota.cat}
                        title={`Filtrar por ${CATEGORIAS[nota.cat]}`}
                      >
                        {CATEGORIAS[nota.cat] || 'Actualidad'}
                      </button>
                    </div>

                    <h4 class="card-title">
                      <a href={`/noticias/${nota.slug}`} class="title-link" set:html={formatTitle(nota.frontmatter.title)}></a>
                    </h4>

                    {getExcerpt(nota) && (
                      <p class="card-bajada">
                        {getExcerpt(nota, 130)}
                      </p>
                    )}

                    <a href={`/noticias/${nota.slug}`} class="read-more-link">
                      Leer artículo <span class="arrow">→</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>

          </div>

          <!-- Mensaje para categoría sin publicaciones -->
          <div class="empty-state-box" id="empty-state-box" hidden>
            <span class="empty-icon">📰</span>
            <h4 class="empty-title">Aún no hay publicaciones en esta sección</h4>
            <p class="empty-text">El equipo de redacción de Mercedes News está preparando notas para este género.</p>
            <button type="button" class="btn-empty-reset" id="btn-empty-reset">
              Ver todas las noticias
            </button>
          </div>

        </section>
      )}

      <!-- Pie de página editorial -->
      <footer class="periodico-footer">
        <div class="footer-divider"></div>
        <div class="footer-content">
          <p class="footer-creditos">
            © {today.getFullYear()} <strong>Mercedes News</strong> — Todos los derechos reservados.
          </p>
          <a href="/admin/" class="footer-admin-link">
            ⚙️ Redacción / CMS
          </a>
        </div>
      </footer>

    </main>

    <!-- Script de interactividad: Header Sticky-Shrink sin rebotes y Filtrado reactivo -->
    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const headerOuter = document.getElementById('header-outer');
        const header = document.getElementById('main-header');
        const dropdownWrapper = document.getElementById('cat-dropdown-wrapper');
        const dropdownBtn = document.getElementById('cat-dropdown-btn');
        const currentCatName = document.getElementById('current-cat-name');
        const dropdownItems = document.querySelectorAll('.dropdown-item');

        const articulosWrapper = document.getElementById('articulos-wrapper');
        const sectionDividerBar = document.getElementById('section-divider-bar');
        const sectionHeadingText = document.getElementById('section-heading-text');
        const grillaSecundarias = document.getElementById('grilla-secundarias');
        const emptyStateBox = document.getElementById('empty-state-box');
        const btnEmptyReset = document.getElementById('btn-empty-reset');

        const CATEGORIAS = {
          'todas': 'Todas',
          'actualidad-local': 'Actualidad Local',
          'cronicas': 'Crónicas & Particularidades',
          'entrevistas': 'Mano a Mano',
          'opinion': 'Opinión & Ensayos'
        };

        // Guardamos todas las tarjetas en memoria
        const allCards = Array.from(document.querySelectorAll('.noticia-card'));

        // 1. HEADER STICKY-SHRINK: Con histéresis y reserva de altura para CERO REBOTE
        if (headerOuter && header) {
          const updateOuterHeight = () => {
            if (!header.classList.contains('is-scrolled')) {
              headerOuter.style.minHeight = `${header.offsetHeight}px`;
            }
          };
          updateOuterHeight();
          window.addEventListener('resize', updateOuterHeight);

          let isScrolled = false;
          const handleScroll = () => {
            const scrollY = window.scrollY;
            // Histéresis: activa pasado los 200px (al dejar el masthead), desactiva por debajo de 120px
            if (!isScrolled && scrollY > 200) {
              isScrolled = true;
              header.classList.add('is-scrolled');
            } else if (isScrolled && scrollY < 120) {
              isScrolled = false;
              header.classList.remove('is-scrolled');
            }
          };

          window.addEventListener('scroll', handleScroll, { passive: true });
          handleScroll();
        }

        // 2. Control del Desplegable (Dropdown)
        function closeDropdown() {
          if (dropdownWrapper) dropdownWrapper.classList.remove('is-open');
          if (dropdownBtn) dropdownBtn.setAttribute('aria-expanded', 'false');
        }

        function toggleDropdown(e) {
          if (e) e.stopPropagation();
          const isOpen = dropdownWrapper.classList.contains('is-open');
          if (isOpen) {
            closeDropdown();
          } else {
            dropdownWrapper.classList.add('is-open');
            dropdownBtn.setAttribute('aria-expanded', 'true');
          }
        }

        if (dropdownBtn) {
          dropdownBtn.addEventListener('click', toggleDropdown);
        }

        document.addEventListener('click', (e) => {
          if (dropdownWrapper && !dropdownWrapper.contains(e.target)) {
            closeDropdown();
          }
        });

        // 3. Filtrado por Categoría (Vanilla JS sin recargar)
        function applyCategoryFilter(cat) {
          const catName = CATEGORIAS[cat] || 'Todas';
          
          // Actualizar texto del botón del selector
          if (currentCatName) currentCatName.textContent = catName;
          
          // Actualizar ítem activo en la lista
          dropdownItems.forEach((item) => {
            if (item.dataset.cat === cat) {
              item.classList.add('is-selected');
            } else {
              item.classList.remove('is-selected');
            }
          });
          closeDropdown();

          if (cat === 'todas') {
            // MODO "TODAS"
            if (emptyStateBox) emptyStateBox.setAttribute('hidden', '');
            if (articulosWrapper) articulosWrapper.style.display = 'block';

            // Restaurar clases y posiciones originales
            allCards.forEach((card, index) => {
              card.style.display = '';
              if (index === 0) {
                card.className = 'noticia-card is-lead';
                if (articulosWrapper && sectionDividerBar) {
                  articulosWrapper.insertBefore(card, sectionDividerBar);
                }
              } else {
                card.className = 'noticia-card is-secondary';
                if (grillaSecundarias) grillaSecundarias.appendChild(card);
              }
            });

            if (sectionDividerBar) sectionDividerBar.style.display = '';
            if (sectionHeadingText) sectionHeadingText.textContent = 'Otras Publicaciones';
            if (grillaSecundarias) grillaSecundarias.style.display = '';
            return;
          }

          // MODO FILTRADO POR CATEGORÍA
          const matchingCards = allCards.filter((card) => card.dataset.cat === cat);

          if (matchingCards.length === 0) {
            // Sección sin notas
            if (articulosWrapper) articulosWrapper.style.display = 'none';
            if (emptyStateBox) emptyStateBox.removeAttribute('hidden');
            return;
          }

          // Hay notas de esta categoría
          if (emptyStateBox) emptyStateBox.setAttribute('hidden', '');
          if (articulosWrapper) articulosWrapper.style.display = 'block';

          // Ocultar tarjetas que no coinciden
          allCards.forEach((card) => {
            if (card.dataset.cat !== cat) {
              card.style.display = 'none';
            } else {
              card.style.display = '';
            }
          });

          // La primera nota de la categoría se promueve a NOTA DE TAPA
          const leadCard = matchingCards[0];
          leadCard.className = 'noticia-card is-lead';
          if (articulosWrapper && sectionDividerBar) {
            articulosWrapper.insertBefore(leadCard, sectionDividerBar);
          }

          // Las demás van a la grilla de secundarias
          const restCards = matchingCards.slice(1);
          if (restCards.length > 0) {
            restCards.forEach((card) => {
              card.className = 'noticia-card is-secondary';
              if (grillaSecundarias) grillaSecundarias.appendChild(card);
            });
            if (sectionDividerBar) sectionDividerBar.style.display = '';
            if (sectionHeadingText) sectionHeadingText.textContent = `Más en ${catName}`;
            if (grillaSecundarias) grillaSecundarias.style.display = '';
          } else {
            if (sectionDividerBar) sectionDividerBar.style.display = 'none';
            if (grillaSecundarias) grillaSecundarias.style.display = 'none';
          }
        }

        // Clicks en opciones del menú desplegable
        dropdownItems.forEach((item) => {
          item.addEventListener('click', () => {
            const cat = item.dataset.cat || 'todas';
            applyCategoryFilter(cat);
          });
        });

        // Botón de reset en pantalla vacía
        if (btnEmptyReset) {
          btnEmptyReset.addEventListener('click', () => applyCategoryFilter('todas'));
        }

        // Clicks en las píldoras de categoría al lado de la fecha
        document.addEventListener('click', (e) => {
          const btn = e.target.closest('[data-filter-cat]');
          if (btn) {
            e.preventDefault();
            e.stopPropagation();
            const cat = btn.dataset.filterCat;
            if (cat) {
              applyCategoryFilter(cat);
              const layout = document.getElementById('noticias-section');
              if (layout) {
                layout.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          }
        });

        // Soporte para URL parameter `?cat=...`
        const urlParams = new URLSearchParams(window.location.search);
        const catFromUrl = urlParams.get('cat');
        if (catFromUrl && CATEGORIAS[catFromUrl]) {
          applyCategoryFilter(catFromUrl);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  /* ========================================================
     ESTILOS GLOBALES EDITORIALES (Mercedes News)
     ======================================================== */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  body {
    font-family: 'Open Sans', sans-serif;
    margin: 0;
    padding: 0;
    color: #1e2126;
    background-color: #ffffff;
    -webkit-font-smoothing: antialiased;
  }

  .index-container {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 10px 20px 60px 20px;
  }

  /* Contenedor del header con altura reservada para eliminar rebotes en scroll */
  .header-outer {
    width: 100%;
    background: #ffffff;
    min-height: 230px;
  }

  /* ========================================================
     CABECERA Y HEADER STICKY-SHRINK
     ======================================================== */
  .periodico-header {
    position: relative;
    background: #ffffff;
    width: 100%;
    transition: box-shadow 0.25s ease;
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 15px 20px 0 20px;
    background: #ffffff;
    transition: padding 0.25s ease;
  }

  /* Barra Superior de Metadatos */
  .top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(2, 82, 197, 0.35);
    padding-bottom: 6px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #555;
    transition: opacity 0.2s ease, max-height 0.2s ease;
  }

  /* Área Principal de Cabecera (Logo + Slogan + Selector) */
  .masthead-area {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 0 10px 0;
    gap: 15px;
    transition: padding 0.25s ease, gap 0.25s ease;
  }

  .brand-box {
    width: 100%;
    text-align: center;
  }

  .brand-link {
    text-decoration: none;
    color: inherit;
    display: block;
    width: 100%;
  }

  /* Logotipo Oficial en Archivo Expanded Black Italic (Ocupa todo el ancho) */
  .diario-title {
    font-family: 'Archivo', sans-serif;
    font-style: italic;
    font-weight: 900;
    font-stretch: expanded;
    font-size: clamp(2.8rem, 8vw, 6.2rem);
    letter-spacing: -2px;
    color: #0252c5;
    margin: 0;
    line-height: 0.95;
    text-transform: uppercase;
    text-align: center;
    width: 100%;
    display: block;
    transition: font-size 0.25s cubic-bezier(0.16, 1, 0.3, 1), letter-spacing 0.25s ease, text-align 0.25s ease;
  }

  .diario-lema {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.88rem;
    font-style: italic;
    color: #666;
    margin: 10px 0 0 0;
    text-align: center;
    transition: opacity 0.2s ease, max-height 0.2s ease;
  }

  /* ========================================================
     SELECTOR DESPLEGABLE DE CATEGORÍAS (DROPDOWN)
     ======================================================== */
  .category-filter-box {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .dropdown-wrapper {
    position: relative;
    display: inline-block;
  }

  .dropdown-trigger-btn {
    background: #ffffff;
    border: 1.5px solid #0252c5;
    border-radius: 22px;
    padding: 7px 20px;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    color: #1e2126;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    box-shadow: 0 2px 6px rgba(2, 82, 197, 0.08);
    transition: all 0.2s ease;
  }

  .dropdown-trigger-btn:hover {
    background: #f0f5ff;
    border-color: #013788;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(2, 82, 197, 0.16);
  }

  .trigger-label {
    font-size: 0.72rem;
    font-weight: 900;
    color: #0252c5;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .trigger-value {
    font-size: 0.86rem;
    font-weight: 700;
    color: #1e2126;
  }

  .trigger-arrow {
    font-size: 0.75rem;
    color: #0252c5;
    transition: transform 0.2s ease;
  }

  .dropdown-wrapper.is-open .trigger-arrow {
    transform: rotate(180deg);
  }

  /* Menú flotante del Dropdown (Oculto por defecto) */
  .dropdown-list {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    min-width: 260px;
    background: #ffffff;
    border: 1px solid #d5d9da;
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.16);
    list-style: none;
    margin: 0;
    padding: 6px;
    z-index: 1050;
    flex-direction: column;
    gap: 2px;
  }

  .dropdown-wrapper.is-open .dropdown-list {
    display: flex;
  }

  .dropdown-item {
    padding: 10px 15px;
    font-family: 'Open Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    color: #1e2126;
    border-radius: 6px;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
    text-align: left;
  }

  .dropdown-item:hover {
    background-color: #f0f5ff;
    color: #0252c5;
  }

  .dropdown-item.is-selected {
    background-color: #0252c5;
    color: #ffffff;
